# Plantilla: copia este archivo como .env (que NO se sube a git) y llena los valores ahí.
# NUNCA pongas contraseñas ni claves reales en este archivo: .env.example SÍ se sube a git.
PORT=3000
HOST=0.0.0.0
# Tiempo máximo por tienda en milisegundos.
STORE_TIMEOUT_MS=6000

# ------------------------------------------------------------------------------
# Cuentas, estadísticas y recomendaciones (ver documentacion.md → "Configurar Supabase y Gmail").
# Si falta alguna de estas variables, la búsqueda sigue funcionando pero sin cuentas.
# ------------------------------------------------------------------------------
# Supabase → Connect → "Session pooler" (URI). Reemplaza [YOUR-PASSWORD] por la contraseña de la base de datos.
DATABASE_URL=
# Opcional (recomendado): ruta al certificado de Supabase (Database Settings → SSL Configuration → Download certificate)
# para verificar la identidad del servidor. Ejemplo: DATABASE_SSL_CA=./supabase-ca.crt
DATABASE_SSL_CA=
# Secreto aleatorio de 64 caracteres. Genéralo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Cuenta de Gmail que envía los códigos y su "contraseña de aplicación" (16 letras).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# SOLO desarrollo: true imprime el código en esta consola en lugar de enviarlo por correo.
MAIL_DEV_LOG=false
# Personas distintas que deben haber buscado algo para que salga en "Lo más buscado".
TRENDING_MIN_PEOPLE=3
# true si el backend se despliega detrás de un proxy (Render, Railway, Fly.io).
TRUST_PROXY=false

# Opcional: activa Mercado Libre. App gratuita en https://developers.mercadolibre.com.co/devcenter
ML_CLIENT_ID=
ML_CLIENT_SECRET=
